# EXAMPLE environment file — copy to `.env` and fill in locally (S0-T5).
#
#     cp .env.example .env      # `.env` is git-ignored; never commit it
#
# NOTHING IN THIS FILE IS A REAL CREDENTIAL. The placeholder values below are
# obvious dummies; replace them in your local `.env` only.
#
# `.env` is NOT read by the loader itself — the loader reads the *process*
# environment. Source it in your shell (`set -a; . ./.env; set +a`) or let your
# editor/devcontainer/compose file inject it. In deployed environments these
# variables come from the platform's secret store, not from a file.
#
# See config/README.md for the full precedence chain.

# --- Profile & file selection (control variables, single underscore) ---------

# Which profile to layer on top of config/default.toml: "local" | "prod".
T_PLAT_PROFILE=local

# Directory holding default.toml / <profile>.toml. Defaults to "./config".
# T_PLAT_CONFIG_DIR=config

# Optional extra file layered on top of the profile file (highest file layer).
# T_PLAT_CONFIG_FILE=config/local.override.toml

# --- Secrets (referenced from the TOML via "env:NAME") ----------------------
#
# Under `local` these may be absent — the loader resolves them to "unset".
# Under `prod` every declared secret MUST resolve or the process fails to boot.

T_PLAT_DATABASE_PASSWORD=replace-me-local-only
T_PLAT_MARKET_DATA_API_KEY=replace-me-local-only

# --- Value overrides (double underscore = nesting) --------------------------
#
# T_PLAT__<SECTION>__<KEY> beats every file. Values are parsed using the type
# declared by the schema, so a bad value is a load error, not a silent string.
#
# T_PLAT__DATABASE__PORT=6543
# T_PLAT__APP__LOG_LEVEL=trace
# T_PLAT__TELEMETRY__SAMPLE_RATE=0.25
